table Realtime
	lineageTag: 713fdb19-4f62-44aa-9414-33ac5f06ca86
	sourceLineageTag: [gold].[bi_eod_sale_product_rlt]

	measure 'Revenue' = SUM('Realtime'[total_amount])
		formatString: #,0
		lineageTag: efb68f76-7296-43e8-a965-86e829faea26

	measure 'Net Revenue' = SUM('Realtime'[final_amount])
		formatString: #,0
		lineageTag: 7c87070c-cde9-43e4-9d90-a81588029bf5

	measure 'Units' = SUM('Realtime'[quantity])
		formatString: #,0
		lineageTag: 403206d5-c4a5-4053-bbb2-5d888c7a6159

	measure 'Transactions' = DISTINCTCOUNT('Realtime'[transaction_id])
		formatString: #,0
		lineageTag: b6d11826-29e6-439d-b790-fcca205082c5

	measure 'Lines' = COUNTROWS('Realtime')
		formatString: #,0
		lineageTag: cec16e5b-f191-46f0-adbb-83be25cfc896

	measure 'AOV' = DIVIDE([Revenue],[Transactions])
		formatString: #,0
		lineageTag: 18675023-29d9-46c8-a918-bcf43010ffee

	measure 'Realtime Revenue' = CALCULATE([Revenue], 'Realtime'[source] = "rlt")
		formatString: #,0
		lineageTag: 4896509f-8e58-40f1-8ab2-bfe51ed3d7dd

	measure 'Batch Revenue' = CALCULATE([Revenue], 'Realtime'[source] = "eod")
		formatString: #,0
		lineageTag: f9653d46-bbfd-45a0-b180-e74659d7d04d

