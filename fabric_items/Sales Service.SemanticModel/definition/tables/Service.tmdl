table Service
	lineageTag: 0507536e-2a08-4248-8809-6a5f0dc7d8f1
	sourceLineageTag: [gold].[bi_eod_sale_service]

	measure 'Total Revenue' = SUM('Service'[total_amount])
		formatString: #,0
		lineageTag: 14cba949-8547-4653-9fc9-15ae8ec3bf74

	measure 'Commission Income' = SUM('Service'[total_commission])
		formatString: #,0
		lineageTag: c090cf0b-3afe-4568-9c11-1aac58ecf306

	measure 'Product Cost' = SUM('Service'[purchase_price_with_tax])
		formatString: #,0
		lineageTag: 8baa6625-1bb2-48e8-b107-e3cf0d3fd2f6

	measure 'Cost-Service Margin' = SUMX(FILTER('Service','Service'[purchase_price_with_tax]>0),'Service'[total_amount]-'Service'[purchase_price_with_tax])
		formatString: #,0
		lineageTag: 84d05285-5de9-49fe-aeac-cfa99d9c2211

	measure 'Gross Margin' = [Commission Income] + [Cost-Service Margin]
		formatString: #,0
		lineageTag: 6fa4c64f-edd8-44f6-8a42-a746f3b7c964

	measure 'Margin %' = DIVIDE([Gross Margin],[Total Revenue])
		formatString: 0.0%
		lineageTag: 06490c36-2ca7-42fc-8d35-c155d6a87447

	measure 'Transaction Count' = DISTINCTCOUNT('Service'[transaction_id])
		formatString: #,0
		lineageTag: 21eefe7f-c5de-49a0-856b-8c621546e866

	measure AOV = DIVIDE([Total Revenue],[Transaction Count])
		formatString: #,0
		lineageTag: c8444623-f3bc-423f-a33c-3c31213b11bb

